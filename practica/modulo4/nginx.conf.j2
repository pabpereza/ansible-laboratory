# files/nginx.conf
user {{ http_user | default("nginx") }};
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    server {
        listen       {{ http_port | default(80)}};
        server_name  _;

        location / {
            root   /var/www/html;
            index  index.html;
        }
    }
}
